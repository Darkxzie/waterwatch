{
  "name": "waterwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:client": "npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:coverage": "npm run test:coverage --workspace server && npm run test:coverage --workspace client",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "audit": "npm audit --workspaces --audit-level=high",
    "secrets:scan": "gitleaks dir . --config .gitleaks.toml",
    "changelog": "git-cliff --output CHANGELOG.md",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "git-cliff": "^2.13.1",
    "gitleaks": "^1.0.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "client/src/**/*.{js,jsx}": [
      "eslint --fix"
    ],
    "server/**/*.{js,mjs}": [
      "eslint --fix"
    ]
  }
}
